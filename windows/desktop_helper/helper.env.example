# Copied to %LOCALAPPDATA%\GrokPC\helper.env by install-helper.ps1.
# The token is taken from WSL /app/agent/.env (AGENT_TOKEN). Never commit a filled copy.
GROKPC_HELPER_TOKEN=
GROKPC_HELPER_HOST=127.0.0.1
GROKPC_HELPER_PORT=8765
# Optional: full path if CapCut is not found automatically
# CAPCUT_PATH=C:\Users\YOU\AppData\Local\CapCut\Apps\CapCut.exe
